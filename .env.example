# Adsterra Publisher API key.
# Get yours from: https://adsterra.com/dashboard/ > API page
# Used by server-side route handlers; never exposed to the browser.
ADSTERRA_API_KEY=your_api_key_here

# Optional: floor date for the dashboard. Defaults to 2026-09-01.
# Any date earlier than this is automatically clamped — old data is hidden.
# ADSTERRA_MIN_DATE=2026-09-01
